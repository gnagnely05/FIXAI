{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "extraBuildArgs": [
          "-Pandroid.kotlinVersion=1.9.25",
          "-Pandroidx.compose.compiler.suppressKotlinVersionCompatibilityCheck=true"
        ]
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "extraBuildArgs": [
          "-Pandroid.kotlinVersion=1.9.25",
          "-Pandroidx.compose.compiler.suppressKotlinVersionCompatibilityCheck=true"
        ]
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "adikofrancis05@gmail.com"
      }
    }
  }
}
